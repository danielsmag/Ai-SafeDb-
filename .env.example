POSTGRES_USER=aisafe
POSTGRES_PASSWORD=aisafe
POSTGRES_DB=aisafedb
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# MCP gateway
GATEWAY_CONFIG_DIR=mcp-servers
GATEWAY_PUBLIC_BASE_URL=http://localhost:8000
GATEWAY_LOG_LEVEL=INFO
GATEWAY_PORT=8000

# Local LLM (Ollama on the host; Docker Compose overrides localhost automatically)
GATEWAY_LLM__BASE_URL=http://localhost:11434/v1
GATEWAY_LLM__API_KEY=not-needed
GATEWAY_LLM__GUARD_MODEL=qwen3:4b
GATEWAY_LLM__AGENT_MODEL=qwen3.6:35b-a3b
GATEWAY_LLM__TIMEOUT_SECONDS=10
GATEWAY_LLM__MAX_CONCURRENCY=2
GATEWAY_LLM__KEEP_ALIVE=10m
GATEWAY_GUARD__ENABLED=false
GATEWAY_GUARD__ON_ERROR=block
GATEWAY_GUARD__INSPECT_RESULTS=true
GATEWAY_GUARD__CACHE_TTL_SECONDS=300

# aisafedb Postgres MCP (mcp-servers/postgres.yaml)
# Local gateway: localhost. In Docker Compose the gateway overrides this to postgres:5432.
POSTGRES_MCP_URL=postgresql://aisafe:aisafe@localhost:5432/aisafedb

# Secrets referenced as ${VAR} from mcp-servers/*.yaml
GITHUB_TOKEN=
DOCS_MCP_TOKEN=
