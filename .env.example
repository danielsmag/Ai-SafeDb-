POSTGRES_USER=aisafe
POSTGRES_PASSWORD=aisafe
POSTGRES_DB=aisafedb
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# Host ports for Compose (not AppSettings).
GATEWAY_PORT=8000
DOCS_PORT=8001
FRONTEND_PORT=5173

# Non-secret gateway defaults live in settings.toml.
# Override any of them here with GATEWAY_* (nested fields use __).
# Example:
# GATEWAY_GUARD__ENABLED=true
# GATEWAY_LOG_LEVEL=DEBUG

# Gateway app DB (API keys + MCP sessions). Schema is created on boot.
GATEWAY_DATABASE__HOST=localhost
GATEWAY_DATABASE__PORT=5432
GATEWAY_DATABASE__USER=aisafe
GATEWAY_DATABASE__PASSWORD=aisafe
GATEWAY_DATABASE__NAME=aisafedb
# Top-level (not GATEWAY_ prefix): dedicated Postgres schema for this app.
SAFE_DB_SCHEMA=aisafedb

# Local LLM (Ollama on the host). GATEWAY_LLM__BASE_URL is intentionally unset
# here: the app already defaults to http://localhost:11434/v1 for local (non-
# Docker) runs, and leaving it unset lets docker-compose.yml fall back to
# http://host.docker.internal:11434/v1 for the containerized gateway. Setting
# it here would override that fallback with a "localhost" that, inside the
# container, points at the container itself instead of the host running Ollama.
GATEWAY_LLM__API_KEY=not-needed

# aisafedb Postgres MCP (mcp-servers/postgres.yaml)
# Local gateway: localhost. In Docker Compose the gateway overrides this to postgres:5432.
POSTGRES_MCP_URL=postgresql://aisafe:aisafe@localhost:5432/aisafedb

# Secrets referenced as ${VAR} from mcp-servers/*.yaml
GITHUB_TOKEN=
DOCS_MCP_TOKEN=
